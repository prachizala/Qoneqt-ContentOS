# ==========================================
# Qoneqt AI Content Factory - Environment Configuration
# ==========================================

# Database & Redis Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qoneqt_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/qoneqt_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/qoneqt_db
REDIS_URL=redis://redis:6379/0

# AI Services API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Audio & Visual Generation Keys
TTS_PROVIDER_KEY=your_tts_provider_key_here
IMAGE_PROVIDER_KEY=your_image_provider_key_here

# Qoneqt Platform Publisher Integration
QONEQT_API_KEY=your_qoneqt_api_key_here
QONEQT_API_URL=https://api.qoneqt.com/v1

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
